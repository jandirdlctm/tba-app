# Copy this file to ".env" and fill in your Supabase project values.
# Find them in the Supabase dashboard → Project Settings → API.
#
# These are read at build time by Vite. They MUST be prefixed with VITE_ to be
# exposed to the browser. The anon key is safe to ship in a client app.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
